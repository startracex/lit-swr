{
  "name": "lit-swr",
  "version": "0.2.0",
  "description": "SWR data fetching for Lit",
  "type": "module",
  "scripts": {
    "build": "tsc"
  },
  "devDependencies": {
    "@lit/reactive-element": "^2.1.2"
  },
  "peerDependencies": {
    "@lit/reactive-element": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@lit/reactive-element": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "import": "./out/index.js"
    },
    "./*": {
      "types": "./out/*.d.ts",
      "import": "./out/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "out"
  ],
  "keywords": [
    "lit",
    "swr"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/startracex/lit-swr.git"
  },
  "license": "MIT",
  "author": "startracex"
}
